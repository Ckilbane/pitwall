{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "manifest.schema.json",
 "title": "PitWall data manifest (data/manifest.json), plus data/models.json and data/history.json.gz",
 "description": "Schema version 1. The root validates data/manifest.json. $defs/modelsFile validates data/models.json; $defs/historyFile validates the decompressed data/history.json.gz. See docs/SPEC.md section 3.",
 "type": "object",
 "required": ["schema", "kind", "data_version", "generated_at", "code_version", "default_season", "default_model", "default_region", "default_watchlist", "models", "seasons", "files", "credits"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": 1},
  "kind": {"const": "manifest"},
  "data_version": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{4}Z-[0-9a-f]{7,40}$", "description": "UTC build time (YYYYMMDDTHHMMZ) + '-' + short git sha of the code that built it. Changes on every deploy that changes any file."},
  "generated_at": {"$ref": "#/$defs/isoTime"},
  "code_version": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
  "default_season": {"$ref": "#/$defs/season"},
  "default_model": {"$ref": "#/$defs/modelId"},
  "default_region": {"type": "string", "description": "Region filter value, e.g. 'fma' (a district abbreviation). See SPEC 5.3 for region syntax."},
  "default_watchlist": {"type": "array", "items": {"type": "integer", "minimum": 1}},
  "models": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "label", "default"],
    "additionalProperties": false,
    "properties": {
     "id": {"$ref": "#/$defs/modelId"},
     "label": {"type": "string"},
     "default": {"type": "boolean"}
    }
   }
  },
  "seasons": {
   "type": "array",
   "description": "Newest season first.",
   "items": {"$ref": "#/$defs/seasonEntry"}
  },
  "files": {
   "type": "object",
   "required": ["models", "history"],
   "additionalProperties": false,
   "properties": {
    "models": {"$ref": "#/$defs/fileRef"},
    "history": {"$ref": "#/$defs/fileRef"}
   }
  },
  "credits": {
   "type": "object",
   "required": ["data", "model", "notice"],
   "properties": {
    "data": {"type": "string"},
    "model": {"type": "string"},
    "notice": {"type": "string"}
   }
  }
 },
 "$defs": {
  "season": {"type": "integer", "minimum": 2022, "maximum": 2100},
  "modelId": {"type": "string", "enum": ["epa", "fast"]},
  "isoTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "UTC, second precision, trailing Z."},
  "hash12": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "First 12 hex chars of SHA-256 of the file bytes as served (the gzip bytes for .json.gz)."},
  "fileRef": {
   "type": "object",
   "required": ["path", "hash", "bytes"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "pattern": "^[0-9a-z_./-]+$", "description": "Relative to data/. Fetch URL = 'data/' + path + '?v=' + hash."},
    "hash": {"$ref": "#/$defs/hash12"},
    "bytes": {"type": "integer", "minimum": 0}
   }
  },
  "seasonEntry": {
   "type": "object",
   "required": ["season", "game", "status", "updated_at", "last_tba_change_at", "stale", "stale_reason", "counts", "files", "events_count", "events_bytes", "inputs_hash", "code_hash"],
   "additionalProperties": false,
   "properties": {
    "season": {"$ref": "#/$defs/season"},
    "game": {"type": "string"},
    "status": {"enum": ["upcoming", "live", "complete"], "description": "upcoming: no completed match; live: season = current season and not all events Completed; complete: otherwise."},
    "updated_at": {"$ref": "#/$defs/isoTime", "description": "When this season's shards were last rebuilt."},
    "last_tba_change_at": {"oneOf": [{"$ref": "#/$defs/isoTime"}, {"type": "null"}], "description": "Latest fetch time at which any raw TBA response for this season changed."},
    "stale": {"type": "boolean", "description": "true when the last rebuild of this season failed and the previous good shards are being served."},
    "stale_reason": {"type": ["string", "null"]},
    "counts": {
     "type": "object",
     "required": ["teams", "events", "matches", "completed_matches"],
     "additionalProperties": false,
     "properties": {
      "teams": {"type": "integer", "minimum": 0},
      "events": {"type": "integer", "minimum": 0},
      "matches": {"type": "integer", "minimum": 0},
      "completed_matches": {"type": "integer", "minimum": 0}
     }
    },
    "files": {
     "type": "object",
     "required": ["season", "asof", "traj"],
     "additionalProperties": false,
     "properties": {
      "season": {"$ref": "#/$defs/fileRef"},
      "asof": {"$ref": "#/$defs/fileRef"},
      "traj": {"$ref": "#/$defs/fileRef"}
     }
    },
    "events_count": {"type": "integer", "minimum": 0, "description": "Number of per-event files for this season (hashes are in season.json events.cols.file_hash)."},
    "events_bytes": {"type": "integer", "minimum": 0, "description": "Sum of per-event file sizes; used for the offline download size."},
    "inputs_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_hash": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}
   }
  },
  "metrics": {
   "type": "object",
   "description": "Backtest metrics; definitions in SPEC 4.5. Null values when n = 0.",
   "required": ["n", "ties", "acc", "acc_no_ties", "brier", "log_loss", "conf", "score_n", "score_mae", "score_rmse", "score_bias", "rp"],
   "additionalProperties": false,
   "properties": {
    "n": {"type": "integer", "minimum": 0},
    "ties": {"type": "integer", "minimum": 0},
    "acc": {"type": ["number", "null"]},
    "acc_no_ties": {"type": ["number", "null"]},
    "brier": {"type": ["number", "null"]},
    "log_loss": {"type": ["number", "null"]},
    "conf": {"type": ["number", "null"]},
    "score_n": {"type": "integer", "minimum": 0},
    "score_mae": {"type": ["number", "null"]},
    "score_rmse": {"type": ["number", "null"]},
    "score_bias": {"type": ["number", "null"]},
    "rp": {
     "type": "object",
     "propertyNames": {"enum": ["rp_1", "rp_2", "rp_3"]},
     "additionalProperties": {
      "type": "object",
      "required": ["n", "brier", "acc"],
      "additionalProperties": false,
      "properties": {
       "n": {"type": "integer", "minimum": 0},
       "brier": {"type": ["number", "null"]},
       "acc": {"type": ["number", "null"]}
      }
     }
    }
   }
  },
  "modelsFile": {
   "type": "object",
   "required": ["schema", "kind", "generated_at", "models", "scoreboard"],
   "additionalProperties": false,
   "properties": {
    "schema": {"const": 1},
    "kind": {"const": "models"},
    "generated_at": {"$ref": "#/$defs/isoTime"},
    "models": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["id", "label", "short_description", "how_it_works", "constants", "settings", "source", "config_hash"],
      "additionalProperties": false,
      "properties": {
       "id": {"$ref": "#/$defs/modelId"},
       "label": {"type": "string"},
       "short_description": {"type": "string"},
       "how_it_works": {"type": "array", "items": {"type": "string"}, "description": "Plain-language paragraphs for the 'How this rating works' panel."},
       "constants": {"type": "object", "description": "Name -> {value, meaning}. EPA: read from vendored src/models/epa/constants.py and EPA static functions, never retyped.", "additionalProperties": {"type": "object", "required": ["value", "meaning"], "properties": {"value": {}, "meaning": {"type": "string"}}}},
       "settings": {"type": "object", "description": "Fast EPA: the frozen config from pipeline/models/fast_epa.json (settings block). EPA: {}."},
       "source": {"type": "string"},
       "config_hash": {"type": "string"},
       "tuning": {"type": "object", "description": "Fast EPA only: tuned_on, tuned_at, objective, chosen, baseline, top results. Copied from pipeline/models/fast_epa.json."}
      }
     }
    },
    "scoreboard": {
     "type": "array",
     "description": "One row per (season, model): overall backtest metrics. Detailed slices live in each season.json backtest block.",
     "items": {
      "type": "object",
      "required": ["season", "model", "overall", "in_tuning_set"],
      "additionalProperties": false,
      "properties": {
       "season": {"$ref": "#/$defs/season"},
       "model": {"$ref": "#/$defs/modelId"},
       "in_tuning_set": {"type": "boolean"},
       "overall": {"$ref": "#/$defs/metrics"}
      }
     }
    }
   }
  },
  "historyFile": {
   "type": "object",
   "description": "Season-over-season table: one row per (team, season) for every team_year in every published season.",
   "required": ["schema", "kind", "generated_at", "rows"],
   "additionalProperties": false,
   "properties": {
    "schema": {"const": 1},
    "kind": {"const": "history"},
    "generated_at": {"$ref": "#/$defs/isoTime"},
    "rows": {
     "type": "object",
     "required": ["n", "cols", "models"],
     "properties": {
      "n": {"type": "integer", "minimum": 0},
      "cols": {
       "type": "object",
       "required": ["team", "season", "name", "district", "state", "country", "wins", "losses", "ties", "count"],
       "additionalProperties": {"type": "array"}
      },
      "models": {
       "type": "object",
       "required": ["epa", "fast"],
       "additionalProperties": {
        "type": "object",
        "required": ["epa", "auto_epa", "teleop_epa", "endgame_epa", "norm_epa", "total_epa_rank", "total_team_count", "district_epa_rank", "district_team_count"],
        "additionalProperties": {"type": "array"}
       }
      }
     }
    }
   }
  }
 }
}
